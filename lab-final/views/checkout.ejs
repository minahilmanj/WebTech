<h2>Checkout</h2>

<% if (cart.length === 0) { %>
    <p>Your cart is empty.</p>
<% } else { %>

    <ul>
        <% cart.forEach(item => { %>
            <li>
                <strong><%= item.name %></strong>
                — <%= item.quantity %> × Rs <%= item.price %>
            </li>
        <% }) %>
    </ul>

    <h3>Total Amount: Rs <%= total %></h3>

    <form method="POST">
        <input
            type="text"
            name="customerName"
            placeholder="Customer Name"
            required
        >

        <input
            type="email"
            name="email"
            placeholder="Email Address"
            required
        >

        <button type="submit">Place Order</button>
    </form>

<% } %>
